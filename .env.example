# Local mock. No credential is required for the dev path.
FNOL_MOCK_URL=http://127.0.0.1:8767
FNOL_STATE_DIR=.state
FNOL_DOCUMENTS_DIR=
FNOL_POLICIES_DIR=

# Leave at 0 to keep the deterministic draft. Set to 1 only with a real Bedrock token.
FNOL_AI_ENABLED=0

# Bedrock. Empty means the shadow summary stays off.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=google.gemma-4-31b
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
BEDROCK_PROMPT_ID=
BEDROCK_PROMPT_VERSION=
BEDROCK_MANTLE_BASE_URL=
BEDROCK_CONTROL_BASE_URL=

# Circuit breaker. 8 consecutive 5xx responses open it. 30 seconds to half-open.
FNOL_CIRCUIT_FAILURE_THRESHOLD=8
FNOL_CIRCUIT_RECOVERY_SECONDS=30

# JSON spans. Set a path to keep a file. Set stderr to 0 to silence the console.
FNOL_LOG_PATH=
FNOL_LOG_STDERR=1

# Unit tests only. Generated at runtime when unset. Not a provider credential.
FNOL_TEST_API_KEY=
